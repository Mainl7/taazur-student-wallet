generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ASSOCIATION_ADMIN
  SCHOOL_ADMIN
  CANTEEN_OPERATOR
  AUDITOR
}
enum EntityStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}
enum CardStatus {
  ACTIVE
  REVOKED
  EXPIRED
}
enum TransactionType {
  CREDIT
  DEBIT
  REFUND
  REVERSAL
  ADJUSTMENT
}

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  role Role
  status EntityStatus @default(ACTIVE)
  schoolId String?
  school School? @relation(fields: [schoolId], references: [id])
  transactions WalletTransaction[] @relation("performedBy")
  auditLogs AuditLog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model School {
  id String @id @default(cuid())
  schoolCode String @unique
  name String
  city String
  district String?
  address String?
  status EntityStatus @default(ACTIVE)
  students Student[]
  users User[]
  transactions WalletTransaction[]
  auditLogs AuditLog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Student {
  id String @id @default(cuid())
  studentCode String @unique
  fullName String
  grade String
  className String?
  status EntityStatus @default(ACTIVE)
  dailyLimit Decimal @db.Decimal(12,2)
  weeklyLimit Decimal? @db.Decimal(12,2)
  schoolId String
  school School @relation(fields: [schoolId], references: [id])
  cards Card[]
  wallet Wallet?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([schoolId, status])
}
model Card {
  id String @id @default(cuid())
  publicToken String @unique @db.VarChar(128)
  status CardStatus @default(ACTIVE)
  studentId String
  student Student @relation(fields: [studentId], references: [id])
  issuedAt DateTime @default(now())
  expiresAt DateTime?
  revokedAt DateTime?
  @@index([studentId, status])
}
model Wallet {
  id String @id @default(cuid())
  studentId String @unique
  student Student @relation(fields: [studentId], references: [id])
  balance Decimal @default(0) @db.Decimal(12,2)
  currency String @default("SAR") @db.VarChar(3)
  status EntityStatus @default(ACTIVE)
  transactions WalletTransaction[]
  updatedAt DateTime @updatedAt
}
model WalletTransaction {
  id String @id @default(cuid())
  reference String @unique
  idempotencyKey String? @unique
  walletId String
  wallet Wallet @relation(fields: [walletId], references: [id])
  studentId String
  schoolId String
  school School @relation(fields: [schoolId], references: [id])
  amount Decimal @db.Decimal(12,2)
  type TransactionType
  balanceBefore Decimal @db.Decimal(12,2)
  balanceAfter Decimal @db.Decimal(12,2)
  performedById String
  performedBy User @relation("performedBy", fields: [performedById], references: [id])
  createdAt DateTime @default(now())
  @@index([studentId, createdAt])
  @@index([schoolId, createdAt])
}
model AuditLog {
  id String @id @default(cuid())
  userId String?
  user User? @relation(fields: [userId], references: [id])
  schoolId String?
  school School? @relation(fields: [schoolId], references: [id])
  action String
  entity String
  entityId String
  oldValue Json?
  newValue Json?
  ip String?
  userAgent String?
  timestamp DateTime @default(now())
  @@index([entity, entityId])
  @@index([schoolId, timestamp])
}

model LoginAttempt {
  id String @id @default(cuid())
  email String @unique
  failedCount Int @default(0)
  lockedUntil DateTime?
  lastAttemptAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
